# Copy to .env and fill in. Never commit .env. Everything here is FREE.

# --- AI (optional; without it the app runs on rules only) ---------------
# Option A: Google Gemini free tier — get a key at https://aistudio.google.com/apikey (no card)
#           Also reads scanned PDFs.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Option B: any OpenAI-compatible free endpoint (Groq free tier, OpenRouter :free models, local Ollama)
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# Seconds between AI calls (free tiers allow ~10–15 per minute)
LLM_MIN_INTERVAL=4

# --- Cloud database (optional; free Supabase project, no card) -----------
# Stores human reviews + uploaded emails so they survive restarts.
# Run docs/supabase.sql in the Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_KEY=

# --- Display name -------------------------------------------------------
APP_NAME=ShipCheck
